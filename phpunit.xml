<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="scim">
            <directory>winter-scim/srcTest</directory>
        </testsuite>
        <testsuite name="saml">
            <directory>winter-saml/srcTest</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>winter-scim/src</directory>
            <directory>winter-saml/src</directory>
        </include>
    </source>
</phpunit>
